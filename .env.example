# Server-side Google OAuth credentials. Never prefix these with VITE_.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Three standalone spreadsheets and the direct KTP destination folder.
GOOGLE_MASTER_DISTRIBUTOR_SPREADSHEET_ID=
GOOGLE_PROVINSI_AREA_SPREADSHEET_ID=
GOOGLE_SUBMISSION_SPREADSHEET_ID=
GOOGLE_DRIVE_KTP_FOLDER_ID=

# Optional sheet-name overrides (defaults shown).
GOOGLE_MASTER_DISTRIBUTOR_SHEET_NAME=master_distributor
GOOGLE_PROVINCE_AREA_SHEET_NAME=provinsi_area
GOOGLE_SUBMISSION_SHEET_NAME=submission
GOOGLE_SUBMISSION_AREA_SHEET_NAME=submission_area
GOOGLE_SUBMISSION_SUPERVISOR_SHEET_NAME=submission_supervisor

# Production browser origin, without a path or trailing slash.
# Localhost:5173 and 127.0.0.1:5173 are allowed automatically in development.
APP_ORIGIN=https://your-supervisor-form.vercel.app
